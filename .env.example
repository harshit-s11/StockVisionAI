# PostgreSQL Datasource Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockvision
SPRING_DATASOURCE_USERNAME=stockvision_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# Spring Security / JWT (Minimum 256-bit / 32 characters)
JWT_SECRET=your_256_bit_secure_random_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
