# Server / Network Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Low-Memory JVM Options (tuned for Render Free 512MB RAM)
JAVA_OPTS="-XX:MaxRAMPercentage=65 -XX:+UseSerialGC -Xss512k -XX:TieredStopAtLevel=1 -Djava.security.egd=file:/dev/./urandom"

# PostgreSQL Database Configuration (Local / Docker Compose)
POSTGRES_DB=stockvision
POSTGRES_USER=stockvision_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Remote Database Configuration (Neon Free Tier with pgvector)
# Note: Keep username and password in separate variables. Do not pass channel_binding.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<direct-host>/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=your_neon_user
# SPRING_DATASOURCE_PASSWORD=your_neon_password

# Hikari Connection Pool Settings (Tuned for low memory / Neon serverless)
# HIKARI_MAXIMUM_POOL_SIZE=5
# HIKARI_MINIMUM_IDLE=1
# HIKARI_CONNECTION_TIMEOUT=30000
# HIKARI_MAX_LIFETIME=300000

# Security / JWT Configuration (Must be at least 256 bits / 32 bytes)
JWT_SECRET=your_secure_256_bit_jwt_secret_key_hex_or_base64_string_here
JWT_EXPIRATION_MS=86400000

# Gemini AI / RAG Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
RAG_TOP_K=5

# Market Simulation Engine
MARKET_SIMULATION_ENABLED=true
MARKET_SIMULATION_INTERVAL_MS=15000
MARKET_SIMULATION_MAX_CHANGE_PERCENT=1.50
MARKET_SIMULATION_MIN_PRICE=1.00
